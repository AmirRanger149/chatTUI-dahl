+    let cursor_char = app.composer[..app.cursor.min(app.composer.len())]
+        .chars()
+        .count();
+
+    let mut rows: Vec<String> = Vec::new();
+    let mut cursor_row = 0usize;
+    let mut cursor_col = PREFIX_W;
